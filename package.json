{
  "name": "baberu-taste",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",

    "db:up": "docker compose --env-file infra/postgres/.env -f infra/postgres/compose.yml up -d",
    "db:down": "docker compose --env-file infra/postgres/.env -f infra/postgres/compose.yml down",
    "db:logs": "docker compose --env-file infra/postgres/.env -f infra/postgres/compose.yml logs -f postgres",
    "db:migrate": "./scripts/db/migrate-local.sh",
    "db:psql": "./scripts/db/psql-local.sh",

    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "ingest:anilist:page": "npm run ingest:anilist:page -w apps/api --",

    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",

    "test:web": "npm run test -w apps/web",
    "test:api": "npm run test -w apps/api",

    "lint:web": "npm run lint -w apps/web",
    "lint:api": "npm run lint -w apps/api"
  }
}
